# SPA routing for RitaGreenOS.
# Real files and directories (api.php, assets, etc.) are served as-is;
# everything else falls through to index.html so React Router can handle it.
# Pass the Authorization header through to PHP (often stripped on shared hosts).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTP:Authorization} .
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Uploaded files are served only through files.php (which checks auth).
  RewriteRule ^uploads/ - [F,L]

  # Don't rewrite requests for the PHP API or other real files/directories.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send everything else to the SPA entry point.
  RewriteRule ^ index.html [L]
</IfModule>

# Send wrong-extension assets with the right type just in case.
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
</IfModule>

# --- Caching ---
# Never cache the HTML entry point, so a new deploy is visible immediately and
# the page always picks up the latest hashed asset names. Content-hashed assets
# (their filename changes every build) are cached long and immutable.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# LiteSpeed (cPanel) server-side cache: don't page-cache the HTML entry, which
# otherwise keeps serving a stale index.html after a deploy.
<IfModule LiteSpeed>
  CacheDisable public /index.html
</IfModule>
