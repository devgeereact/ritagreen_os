# .htaccess for RitaGreenOS.
#
# IMPORTANT: this file is NOT deployed automatically. .github/workflows/deploy.yml
# excludes **/.htaccess, and cpanel-deploy excludes it too, because the copy on
# the server is hand-maintained and carries things this repo cannot know about.
# The SERVER copy is authoritative. Keep this one in step with it so that if
# anyone ever does upload it, nothing is silently lost.
#
# It had drifted: the Cloudflare origin lock and the webmanifest MIME type both
# existed on the server and were missing here. Deploying this file as it stood
# would have removed the origin lock (re-exposing the origin to direct-to-origin
# traffic, bypassing the WAF) and broken PWA installability.

# === BEGIN Cloudflare-origin-lock (2026-08-24) ===
# Cloudflare IP restoration is ON, so REMOTE_ADDR is the VISITOR's IP for proxied
# traffic -- an IP allow-list would block real users. LiteSpeed also ignores
# "Require ip" in .htaccess (verified). So we key on Cloudflare's own headers,
# which are present on proxied requests and absent on direct-to-origin hits.
# NOTE: a determined attacker can forge CF-RAY. This stops mass scanners, it is
# not a cryptographic boundary -- that needs Authenticated Origin Pulls (mTLS).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:CF-RAY} ^$
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ - [F,L]
</IfModule>
# === END Cloudflare-origin-lock ===
# SPA routing for RitaGreenOS.
# Real files and directories (api.php, assets, etc.) are served as-is;
# everything else falls through to index.html so React Router can handle it.
# Pass the Authorization header through to PHP (often stripped on shared hosts).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTP:Authorization} .
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Uploaded files are served only through files.php (which checks auth).
  RewriteRule ^uploads/ - [F,L]

  # Don't rewrite requests for the PHP API or other real files/directories.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send everything else to the SPA entry point.
  RewriteRule ^ index.html [L]
</IfModule>

# Send wrong-extension assets with the right type just in case.
<IfModule mod_mime.c>
  # PWA. Without the correct manifest type the browser will not offer to install
  # the app -- it was being served as application/octet-stream.
  AddType application/manifest+json .webmanifest
  AddType application/javascript .js
  AddType text/css .css
</IfModule>

# --- Security headers ---
# The site shipped none of these. Each one closes something specific:
#
#   nosniff            stops a browser deciding an uploaded .txt is really HTML
#                      and running it. files.php serves user uploads.
#   frame-options      the CMS holds workforce records behind a session; without
#                      this it can be framed and clickjacked.
#   referrer-policy    a full URL leaks record ids (/app/clients/41) to whatever
#                      a user clicks through to. Origin-only on cross-origin.
#   permissions-policy switches off device APIs nothing here asks for.
#   HSTS               the whole site is HTTPS behind Cloudflare; this stops the
#                      first request of a session going out in the clear.
#                      No `preload` -- that is a one-way submission and belongs
#                      to whoever owns the domain, not to a deploy.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

  # Content-Security-Policy.
  #
  # 'unsafe-inline' is present for styles only, and is not removable today:
  # Tailwind is compiled to a stylesheet but Radix, the FullCalendar build and
  # ApexCharts all set inline style attributes at runtime, and several components
  # here compute a colour into style={{...}}. Scripts carry no such exemption --
  # which is the half that matters, and the half that turns a stored-XSS bug into
  # a non-event. `connect-src 'self'` is enough because every third-party call is
  # proxied server-side; nothing in the bundle talks to an API directly.
  #
  # frame-ancestors repeats X-Frame-Options for browsers that have dropped it.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# --- Caching ---
# Never cache the HTML entry point, so a new deploy is visible immediately and
# the page always picks up the latest hashed asset names. Content-hashed assets
# (their filename changes every build) are cached long and immutable.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# LiteSpeed (cPanel) server-side cache: don't page-cache the HTML entry, which
# otherwise keeps serving a stale index.html after a deploy.
<IfModule LiteSpeed>
  CacheDisable public /index.html
</IfModule>
